---
import { lessons, CHEAT } from '@data/lessons';

interface Props { slug: string }
const { slug } = Astro.props;

const base = import.meta.env.BASE_URL; // '/pl-lessons/'
const i = lessons.findIndex((l) => l.slug === slug);
const cur = lessons[i];
const prev = i > 0 ? lessons[i - 1] : null;
const next = i < lessons.length - 1 ? lessons[i + 1] : null;

const lessonHref = (s: string) => `${base}lessons/${s}/`;
const cheatHref = `${base}${CHEAT.href}`;

const nextHref = next ? lessonHref(next.slug) : cheatHref;
const nextLabel = next ? `Урок ${next.num}: ${next.navLabel} →` : `${CHEAT.label} →`;
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Урок {cur.num} — {cur.pl}</title>
    <link rel="stylesheet" href={`${base}assets/style.css`} />
    <!-- Defines the global Quiz before each lesson's inline Quiz.render() call. -->
    <script is:inline src={`${base}assets/quiz.js`}></script>
  </head>
  <body>
    <header class="lesson-header">
      <div class="lesson-meta">
        <span>Урок {cur.num} з {lessons.length}</span>
        <span>{cur.dur}</span>
        <a href={nextHref}>{nextLabel}</a>
      </div>
      <h1>{cur.pl}</h1>
      <p class="lesson-subtitle">{cur.sub}</p>
    </header>

    <slot />

    <div class="lesson-complete">
      <button class="mark-complete" type="button" data-mark-complete data-slug={cur.slug} aria-pressed="false">
        Позначити як пройдений
      </button>
    </div>

    <footer class="lesson-footer">
      {prev && <a class="nav-prev" href={lessonHref(prev.slug)}>← Урок {prev.num}: {prev.navLabel}</a>}
      <span>{cur.footerNote}</span>
      <a href={nextHref}>{nextLabel}</a>
    </footer>

    <script>
      // Per-lesson "mark/unmark as complete", persisted in localStorage.
      const KEY = 'pl-lessons:completed';
      const read = () => {
        try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; }
      };
      const write = (arr) => localStorage.setItem(KEY, JSON.stringify(arr));

      const btn = document.querySelector('[data-mark-complete]');
      if (btn) {
        const slug = btn.getAttribute('data-slug');
        const render = (done) => {
          btn.classList.toggle('is-done', done);
          btn.setAttribute('aria-pressed', String(done));
          btn.textContent = done ? '✓ Урок пройдено' : 'Позначити як пройдений';
        };
        let done = read().includes(slug);
        render(done);
        btn.addEventListener('click', () => {
          done = !done;
          const set = new Set(read());
          if (done) set.add(slug); else set.delete(slug);
          write([...set]);
          render(done);
        });
      }
    </script>
  </body>
</html>
